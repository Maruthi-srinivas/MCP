# Copy to .env if you want to override the Compose defaults.
# Docker Compose reads this file automatically for ${VAR} substitution.
# Never commit a real .env.

# Optional. Used only by git inside the repository-mcp container.
# Never returned by a tool and never written to logs.
GITHUB_TOKEN=

# Safety limits. These match the V0.1 teaching defaults.
MAX_READ_LINES=200
MAX_FILE_BYTES=1048576
MAX_SEARCH_HITS=50
MAX_DIRECTORY_ENTRIES=200
CLONE_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=30

# Python indexer limits (V0.2).
MAX_PYTHON_FILES=200
MAX_SYMBOLS=500
MAX_REFERENCES=50
INDEX_TIMEOUT_SECONDS=30

# How many commits a shallow clone keeps for the Git MCP.
GIT_CLONE_DEPTH=50

# Git MCP page and diff caps.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50
MAX_DIFF_LINES=200
MAX_BRANCHES=50

# Analysis MCP caps (V0.4).
ANALYSIS_TIMEOUT=30
MAX_FUNCTIONS=500
MAX_CLASSES=500
MAX_ENDPOINTS=200
MAX_EDGES=500
MAX_HINTS=200

# Resource JSON documents stop at this many characters (V0.6).
RESOURCE_MAX_CHARS=8000

# Agent loop bounds (V0.5). The key is optional. Leave it empty to start the
# agent without calling OpenAI. Investigations then return a configuration error.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_STEPS=8
MAX_TOOL_CALLS=12
MAX_TOOL_OUTPUT_CHARS=4000
AGENT_TIMEOUT_SECONDS=60
MAX_RETRIES=2

# API persistence (V0.7). Postgres and Redis stay on the Compose network.
# The password below is the teaching default for the local stack.
DATABASE_URL=postgresql://investigator:investigator@postgres:5432/investigator
REDIS_URL=redis://redis:6379/0
IMPORTS_PER_MINUTE=10
ANALYSES_PER_MINUTE=5
WORKSPACE_TTL_SECONDS=604800
CACHE_TTL_SECONDS=3600
MAX_FILE_ROWS=2000

# Local caller tokens (V0.9). These are teaching placeholders, not passwords.
ALICE_TOKEN=alice-local-token
BOB_TOKEN=bob-local-token
MAX_CONCURRENT_IMPORTS=2
MAX_ANALYSIS_JOBS=3
MAX_BODY_BYTES=1000000

# The UI is published on port 3000 and calls the API on port 8004.
# MCP and the agent are not published on the host.
